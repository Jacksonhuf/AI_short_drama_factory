# Created automatically at /opt/jellyfish/.env on the first VPS deployment.
# Keep actual values only on the VPS; never commit this file with populated secrets.
DOMAIN=drama.xclawapi.com
JELLYFISH_IMAGE_TAG=replace-at-deploy-time
MYSQL_ROOT_PASSWORD=replace-with-a-random-secret
MYSQL_DATABASE=jellyfish
MYSQL_USER=jellyfish
MYSQL_PASSWORD=replace-with-a-random-secret
REDIS_DB=0
RUSTFS_ACCESS_KEY=jellyfish
RUSTFS_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET_NAME=jellyfish-assets
OPENAI_API_KEY=
